# Required
DATABASE_URL=postgresql://username:password@host:5432/database
SESSION_SECRET=replace-with-a-long-random-string

# Optional (Compose local Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=moderateai
POSTGRES_PORT=5432
# Optional public port exposed by reverse proxy in docker-compose
APP_PUBLIC_PORT=5000

# AI
OPENAI_API_KEY=
OPENAI_REQUEST_TIMEOUT_MS=15000
OPENAI_MAX_CONCURRENCY=8
OPENAI_MAX_QUEUE=120
OPENAI_QUEUE_TIMEOUT_MS=5000

# Optional (dashboard aggregation cache and UI motion profile)
DASHBOARD_OVERVIEW_CACHE_TTL_MS=10000
# balanced | full_motion
UI_PERF_PROFILE=balanced
# Optional (staged UI v2 rollout controls)
# Defaults: UI v2 disabled unless explicitly enabled.
UI_V2_ENABLED=0
# Comma-separated route keys: all,dashboard,conversations,knowledge-base,integrations,admin-users,learning-ops,settings,team,activity,analytics,billing,profile,preferences,help,landing,auth,legal
UI_V2_ROUTE_SCOPE=
# Optional comma-separated preview allowlist (lowercased emails)
UI_V2_ALLOWLIST_EMAILS=
# Optional comma-separated preview roles (owner,admin,moderator,viewer)
UI_V2_FORCE_ROLES=
# Optional (Wave 1 full redo parallel v2.1 rollout controls)
# Redo only applies when UI v2 is enabled for the request.
UI_WAVE1_REDO_ENABLED=0
# Comma-separated route keys for Wave 1 redo: all,dashboard,conversations,knowledge-base,integrations
UI_WAVE1_REDO_ROUTE_SCOPE=
# Optional comma-separated preview allowlist (lowercased emails)
UI_WAVE1_REDO_ALLOWLIST_EMAILS=
# Optional comma-separated preview roles (owner,admin,moderator,viewer)
UI_WAVE1_REDO_FORCE_ROLES=

# Optional (owner bootstrap)
OWNER_EMAIL=admin@moderateai.net
OWNER_NAME=ModerateAI Admin

# Optional (set in production)
NODE_ENV=production
FRONTEND_URL=http://localhost:5000
# Optional (HTTP response hardening + tracing)
SECURITY_HEADERS_ENABLED=1
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
API_SLOW_REQUEST_THRESHOLD_MS=2000

# Optional (support link shown in pricing/onboarding CTAs)
VITE_SUPPORT_TELEGRAM_URL=https://t.me/MykKali
# Optional (public documentation base URL; GitBook canonical docs)
VITE_DOCS_BASE_URL=https://docs.moderateai.net
# Optional (public site origin used for canonical/OG URLs in SPA route metadata)
VITE_SITE_URL=https://www.moderateai.net
# Optional (legacy Discord BYOB setup OAuth client id used by existing UI path)
VITE_DISCORD_CLIENT_ID=

# Optional (hybrid integrations: app-owned default + Pro BYOB)
TELEGRAM_APP_BOT_TOKEN=
DISCORD_APP_BOT_TOKEN=
# Optional fallback metadata for app-owned invite links shown in UI
TELEGRAM_APP_BOT_USERNAME=
DISCORD_APP_BOT_CLIENT_ID=
# Discord permission integer for bot invite URL; defaults to minimal practical permissions.
DISCORD_APP_BOT_INVITE_PERMISSIONS=
INTEGRATION_CLAIM_CODE_TTL_MINUTES=10
INTEGRATION_UNCLAIMED_HINT_COOLDOWN_MINUTES=60
# Feature flags for safety hardening rollout
# Defaults: enabled outside production, disabled in production unless explicitly set
INTEGRATION_SAFETY_HARDENING_ENABLED=
# Keeps destination-level claim lock enabled by default
INTEGRATION_CLAIM_DESTINATION_LOCK_ENABLED=1

# Optional (destination timed lock controls for Telegram/Discord)
# Defaults: BOT_TIMED_LOCKS_ENABLED=true in non-production, false in production.
BOT_TIMED_LOCKS_ENABLED=
# Scheduled auto-lock evaluation is off by default.
BOT_AUTO_LOCKS_ENABLED=0
BOT_LOCK_SWEEP_INTERVAL_MS=30000
BOT_LOCK_MAX_DURATION_MINUTES=1440

# Optional (admin-history learning automation + historical backfill)
# Defaults: enabled outside production, disabled in production unless explicitly set.
ADMIN_HISTORY_AUTO_ANALYSIS_ENABLED=
ADMIN_HISTORY_AUTO_ANALYSIS_INTERVAL_MS=1800000
ADMIN_HISTORY_AUTO_ANALYSIS_MIN_NEW_ADMIN_MESSAGES=10
ADMIN_HISTORY_BACKFILL_ON_STARTUP_ENABLED=
ADMIN_HISTORY_BACKFILL_MAX_DAYS=90
ADMIN_HISTORY_BACKFILL_MAX_MESSAGES_PER_DESTINATION=5000
ADMIN_HISTORY_ADMIN_CHECK_CACHE_TTL_MS=300000

# Optional (Knowledge Base URL Sync crawler + scheduler)
# Manual sync endpoints work regardless of scheduler flag.
# Defaults: scheduler enabled outside production, disabled in production unless explicitly set.
KB_URL_SYNC_SCHEDULER_ENABLED=
KB_URL_SYNC_SWEEP_INTERVAL_MS=60000
KB_URL_SYNC_MAX_PAGES_PER_RUN=200
KB_URL_SYNC_MAX_DEPTH=4
KB_URL_SYNC_MAX_RUN_MS=300000
KB_URL_SYNC_PAGE_TIMEOUT_MS=10000
KB_URL_SYNC_HTML_MAX_BYTES=1048576
KB_URL_SYNC_GLOBAL_CONCURRENCY=2
# Startup delay before scheduler begins sweeping (milliseconds)
KB_URL_SYNC_STARTUP_DELAY_MS=30000

# Optional (server-side knowledge file parsing for binary uploads)
# Max multipart file size accepted by KB parse/upload endpoints
KB_FILE_UPLOAD_MAX_BYTES=10485760
# Max extracted text retained from a parsed file before truncation
KB_FILE_EXTRACT_MAX_CHARS=200000

# Optional (public website widget rate limits)
# Requests per window per IP+widget token
WIDGET_BOOTSTRAP_RATE_LIMIT=60
WIDGET_CHAT_RATE_LIMIT=40
WIDGET_LEAD_RATE_LIMIT=12
# Window size in milliseconds (default 60s)
WIDGET_RATE_LIMIT_WINDOW_MS=60000
# Include session dimension in widget rate-limit key when available
WIDGET_RATE_LIMIT_USE_SESSION_KEY=1
# Widget session-binding rollout flags (compatibility-first defaults)
WIDGET_STRICT_SESSION_BINDING_ENABLED=0
WIDGET_REQUIRE_SESSION_ID_FOR_LEAD=0
WIDGET_LEAD_DEDUP_WINDOW_HOURS=24
# Optional explicit signing secret (falls back to SESSION_SECRET)
WIDGET_SESSION_TOKEN_SECRET=
# Optional session token TTL in seconds
WIDGET_SESSION_TOKEN_TTL_SECONDS=3600

# Optional (auth endpoint rate limits; applies to /api/login and /api/signup)
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_CLEANUP_INTERVAL_MS=300000
# Backend options: postgres | redis
AUTH_RATE_LIMIT_BACKEND=postgres
# Used when AUTH_RATE_LIMIT_BACKEND=redis (falls back to REDIS_URL if unset)
AUTH_RATE_LIMIT_REDIS_URL=
AUTH_RATE_LIMIT_REDIS_PREFIX=moderateai:auth_rate_limits
AUTH_RATE_LIMIT_REDIS_FALLBACK_TO_POSTGRES=1
# Optional non-production bypass token for regression scripts
# (scripts send this automatically when set)
AUTH_RATE_LIMIT_TEST_BYPASS_TOKEN=

# Optional (ops alert thresholds for repeated error patterns)
OPS_ALERT_WINDOW_MS=300000
OPS_ALERT_RATE_LIMIT_429_THRESHOLD=20
OPS_ALERT_DAILY_QUOTA_THRESHOLD=12
OPS_ALERT_WIDGET_SESSION_TOKEN_ISSUED_THRESHOLD=120
OPS_ALERT_WIDGET_SESSION_TOKEN_INVALID_THRESHOLD=20
OPS_ALERT_WIDGET_SOURCE_BINDING_REJECTED_THRESHOLD=20
OPS_ALERT_WIDGET_LEAD_DEDUP_HIT_THRESHOLD=60
OPS_ALERT_WIDGET_STORAGE_FALLBACK_USED_THRESHOLD=30
OPS_ALERT_AUTH_SESSION_THRESHOLD=5
OPS_ALERT_AUTH_RATE_LIMIT_429_THRESHOLD=20
OPS_ALERT_AUTH_RATE_LIMIT_FAILURE_THRESHOLD=5
OPS_ALERT_OPENAI_FAILURE_THRESHOLD=8
OPS_ALERT_API_SLOW_REQUEST_THRESHOLD=30
OPS_ALERT_API_5XX_RESPONSE_THRESHOLD=8
OPS_ALERT_INTEGRATION_CLAIM_ATTEMPT_THRESHOLD=50
OPS_ALERT_INTEGRATION_CLAIM_FAILURE_THRESHOLD=20
OPS_ALERT_INTEGRATION_CLAIM_CONFLICT_THRESHOLD=20
OPS_ALERT_INTEGRATION_CLAIM_CONSUME_FAILED_THRESHOLD=20
OPS_ALERT_INTEGRATION_UNCLAIMED_HINT_THRESHOLD=40
OPS_ALERT_MODERATION_CHECK_FAILED_THRESHOLD=20
OPS_ALERT_DESTINATION_LOCK_APPLY_THRESHOLD=25
OPS_ALERT_DESTINATION_LOCK_APPLY_FAILED_THRESHOLD=15
OPS_ALERT_DESTINATION_UNLOCK_THRESHOLD=25
OPS_ALERT_DESTINATION_UNLOCK_FAILED_THRESHOLD=12
OPS_ALERT_DESTINATION_LOCK_AUTO_TRIGGERED_THRESHOLD=25
OPS_ALERT_DESTINATION_LOCK_EXTENDED_THRESHOLD=25
OPS_ALERT_DESTINATION_UNLOCK_ALL_THRESHOLD=20

# Optional (conversation retention cleanup interval; default 24h)
RETENTION_SWEEP_INTERVAL_MS=86400000

# Optional (manual test mode; not used by app runtime)
# Enable heavier Standard/Pro KB overflow simulation in `npm run test:tier:matrix`
TIER_MATRIX_STRESS_KB_OVERFLOW=0
TIER_MATRIX_STRESS_KB_PLANS=standard,pro
TIER_MATRIX_STRESS_KB_HEADROOM_BYTES=4096
TIER_MATRIX_STRESS_KB_OVERFLOW_DOC_BYTES=8192
